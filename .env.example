# NovaFlow 环境变量示例
# 复制为 .env 后按需修改（application-dev 会自动 optional 加载 .env[.properties]）

# MySQL
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/novaflow?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&createDatabaseIfNotExist=true
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=root

# Redis（与 docker-compose.local.yml 一致）
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis123

# MinIO 对象存储
MINIO_ENDPOINT=http://your-minio-host:9000
MINIO_ACCESS_KEY=your-access-key
MINIO_SECRET_KEY=your-secret-key
MINIO_BUCKET=novaflow

# Qdrant 向量库（本地 Docker 可留空 API Key）
QDRANT_HOST=localhost
QDRANT_PORT=6334
QDRANT_API_KEY=

# 安全（crypto-key 须为足够长度的随机字符串，建议 32 字节）
NOVAFLOW_CRYPTO_KEY=请替换为32字节随机密钥
CORS_ALLOWED_ORIGIN=http://localhost:3000

# 限流与登录保护
LOGIN_RATE_LIMIT_PER_MINUTE=20
LOGIN_FAILURE_THRESHOLD=5
LOGIN_LOCK_MINUTES=15
OPEN_API_RATE_LIMIT_PER_MINUTE=60
