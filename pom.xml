<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.5</version>
        <relativePath/>
    </parent>

    <groupId>ai.novaflow</groupId>
    <artifactId>novaflow-ai</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>NovaFlow AI</name>
    <description>Enterprise AI Agent Development Platform</description>

    <modules>
        <module>novaflow-common</module>
        <module>novaflow-security</module>
        <module>novaflow-user</module>
        <module>novaflow-tenant</module>
        <module>novaflow-application</module>
        <module>novaflow-agent</module>
        <module>novaflow-prompt</module>
        <module>novaflow-workflow</module>
        <module>novaflow-knowledge</module>
        <module>novaflow-model</module>
        <module>novaflow-tool</module>
        <module>novaflow-chat</module>
        <module>novaflow-dashboard</module>
        <module>novaflow-monitor</module>
        <module>novaflow-billing</module>
        <module>novaflow-observability</module>
        <module>novaflow-ai-engine</module>
        <module>novaflow-ai-rag</module>
        <module>novaflow-ai-workflow-engine</module>
        <module>novaflow-server</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <mybatis-flex.version>1.9.9</mybatis-flex.version>
        <sa-token.version>1.39.0</sa-token.version>
        <langchain4j.version>0.36.2</langchain4j.version>
        <liteflow.version>2.12.4</liteflow.version>
        <hutool.version>5.8.32</hutool.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>ai.novaflow</groupId>
                <artifactId>novaflow-common</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>ai.novaflow</groupId>
                <artifactId>novaflow-security</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>ai.novaflow</groupId>
                <artifactId>novaflow-user</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>ai.novaflow</groupId>
                <artifactId>novaflow-tenant</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>ai.novaflow</groupId>
                <artifactId>novaflow-application</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>ai.novaflow</groupId>
                <artifactId>novaflow-agent</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>ai.novaflow</groupId>
                <artifactId>novaflow-prompt</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>ai.novaflow</groupId>
                <artifactId>novaflow-workflow</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>ai.novaflow</groupId>
                <artifactId>novaflow-knowledge</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>ai.novaflow</groupId>
                <artifactId>novaflow-model</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>ai.novaflow</groupId>
                <artifactId>novaflow-tool</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>ai.novaflow</groupId>
                <artifactId>novaflow-chat</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>ai.novaflow</groupId>
                <artifactId>novaflow-dashboard</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>ai.novaflow</groupId>
                <artifactId>novaflow-monitor</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>ai.novaflow</groupId>
                <artifactId>novaflow-billing</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>ai.novaflow</groupId>
                <artifactId>novaflow-observability</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>ai.novaflow</groupId>
                <artifactId>novaflow-ai-engine</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>ai.novaflow</groupId>
                <artifactId>novaflow-ai-rag</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>ai.novaflow</groupId>
                <artifactId>novaflow-ai-workflow-engine</artifactId>
                <version>${project.version}</version>
            </dependency>

            <dependency>
                <groupId>com.mybatis-flex</groupId>
                <artifactId>mybatis-flex-spring-boot3-starter</artifactId>
                <version>${mybatis-flex.version}</version>
            </dependency>
            <dependency>
                <groupId>cn.dev33</groupId>
                <artifactId>sa-token-spring-boot3-starter</artifactId>
                <version>${sa-token.version}</version>
            </dependency>
            <dependency>
                <groupId>cn.dev33</groupId>
                <artifactId>sa-token-redis-jackson</artifactId>
                <version>${sa-token.version}</version>
            </dependency>
            <dependency>
                <groupId>cn.hutool</groupId>
                <artifactId>hutool-all</artifactId>
                <version>${hutool.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <configuration>
                        <release>${java.version}</release>
                        <parameters>true</parameters>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
