# 生产部署环境变量示例
# 复制为项目根目录 .env 后执行 docker compose -f deploy/docker-compose.prod.yml up -d --build

MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=novaflow
REDIS_PASSWORD=change-me-redis
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change-me-minio
MINIO_BUCKET=novaflow
NOVAFLOW_CRYPTO_KEY=replace-with-a-strong-random-32plus-chars
# 生产必须写成真实前端 Origin（含协议+域名+端口）。禁止默认 localhost。
# 仅本机 docker 冒烟可临时用 http://localhost:3000 并设 NOVAFLOW_CORS_ALLOW_LOCALHOST=true
CORS_ALLOWED_ORIGIN=https://your-frontend.example.com
NOVAFLOW_CORS_ALLOW_LOCALHOST=false
NOVAFLOW_REGISTRATION_ENABLED=false
SERVER_PORT=8080
WEB_PORT=3000

# OpenTelemetry / Langfuse（可选）
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
