# 生产部署环境变量示例
# 复制为项目根目录 .env 后执行 docker compose -f deploy/docker-compose.prod.yml up -d --build

MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=novaflow
REDIS_PASSWORD=change-me-redis
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change-me-minio
MINIO_BUCKET=novaflow
NOVAFLOW_CRYPTO_KEY=change-me-32-char-crypto-key-here
CORS_ALLOWED_ORIGIN=http://localhost
SERVER_PORT=8080
WEB_PORT=80

# OpenTelemetry / Langfuse（可选）
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
