        <dependency>
            <groupId>ai.novaflow</groupId>
            <artifactId>novaflow-dashboard</artifactId>
        </dependency>
        <dependency>
            <groupId>ai.novaflow</groupId>
            <artifactId>novaflow-user</artifactId>
        </dependency>
        <dependency>
            <groupId>ai.novaflow</groupId>
            <artifactId>novaflow-agent</artifactId>
        </dependency>
        <dependency>
            <groupId>ai.novaflow</groupId>
